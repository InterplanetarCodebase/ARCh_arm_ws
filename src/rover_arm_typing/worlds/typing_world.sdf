<?xml version="1.0"?>
<sdf version="1.9">
  <world name="typing_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required for the wrist rgbd_camera to render. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table + keyboard in front of the arm (arm spawns at the origin).
         Keyboard rotated 90 deg so its long axis runs laterally (world Y)
         across the arm's workspace, space bar toward the arm.  Keyboard
         face top surface: z = 0.35.  Ground-truth key world position for
         a layout entry (kx, ky):  x = 0.78 - ky,  y = -kx,  z = 0.35
         (verified against detector output in sim). -->
    <include>
      <uri>model://typing_table</uri>
      <name>typing_table</name>
      <pose>0.78 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://aruco_keyboard</uri>
      <name>aruco_keyboard</name>
      <pose>0.78 0 0.34 0 0 1.5708</pose>
    </include>
  </world>
</sdf>

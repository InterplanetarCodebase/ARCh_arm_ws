<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Model frame matches the "keyboard surface frame" used by
       key_layout.yaml: origin at the keyboard centre, +x along the long
       axis, +y toward the space bar.  The textured face is the top
       (+z up). -->
  <model name="aruco_keyboard">
    <static>true</static>
    <link name="body">
      <collision name="body_collision">
        <geometry>
          <box><size>0.50 0.20 0.02</size></box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box><size>0.50 0.20 0.018</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Thin textured slab riding on top of the body so the keyboard
           face texture is only visible from above. -->
      <visual name="face_visual">
        <pose>0 0 0.0095 0 0 0</pose>
        <geometry>
          <box><size>0.50 0.20 0.001</size></box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_keyboard/materials/textures/keyboard.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
